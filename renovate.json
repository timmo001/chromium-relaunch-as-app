{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:recommended"
  ],
  "packageRules": [
    {
      "description": "Update the Effect runtime and integrations together.",
      "matchPackageNames": ["effect", "@effect/platform-*", "@effect/vitest"],
      "groupName": "Effect",
      "groupSlug": "effect"
    }
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ]
}
