{
  "name": "chromium-relaunch-as-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run --parallel build:extension build:native:*",
    "build:extension": "bun build src/background.ts src/popup.ts --target=browser --format=iife --outdir=extension/dist",
    "build:native:relaunch": "bun build src/native/relaunch-host.ts --compile --outfile dist/relaunch-current-page-host",
    "build:native:browser-urls": "bun build src/native/browser-urls-host.ts --compile --outfile dist/browser-urls-host",
    "build:native:install": "bun build src/native/install-native-host.ts --compile --outfile dist/install-native-host",
    "check": "bun run --parallel --no-exit-on-error lint typecheck test format:check build",
    "format": "prettier --write \"{src,tests}/**/*.ts\" oxlint.config.ts package.json tsconfig.json",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\" oxlint.config.ts package.json tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-tsgo patch --force=false"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.2",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "4.0.2",
    "@oxlint/plugins": "1.87.0",
    "@timmo001/oxlint-rules": "0.5.0",
    "@types/bun": "1.4.2",
    "@types/chrome": "0.3.4",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
